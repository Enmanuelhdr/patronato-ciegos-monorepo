<log4net>
  <!-- Log a nivel de archivo para la Caja: login, cobros (venta/masaje/préstamo/donación),
       caídas de conexión con el Gateway y sincronización de la cola offline (ver
       App.xaml.cs, ApiService y OfflineQueueService). LogRoot se fija en AppData porque la
       Caja puede instalarse en una carpeta de solo lectura (Program Files); es la misma
       carpeta donde ya vive cola_pendientes.json. -->
  <appender name="RollingFile" type="log4net.Appender.RollingFileAppender">
    <file type="log4net.Util.PatternString" value="%property{LogRoot}/logs/caja.log" />
    <appendToFile value="true" />
    <rollingStyle value="Date" />
    <datePattern value="yyyyMMdd" />
    <staticLogFileName value="true" />
    <maxSizeRollBackups value="30" />
    <lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date{yyyy-MM-dd HH:mm:ss} [%level] %logger - %message%newline%exception" />
    </layout>
  </appender>

  <root>
    <level value="INFO" />
    <appender-ref ref="RollingFile" />
  </root>
</log4net>
