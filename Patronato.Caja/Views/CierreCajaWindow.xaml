<Window x:Class="Patronato.Caja.Views.CierreCajaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reporte de Cierre de Caja - Patronato Nacional de Ciegos"
        Height="780" Width="820"
        MinHeight="600" MinWidth="700"
        WindowStartupLocation="CenterOwner"
        Background="#F1F5F9">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Documento de cierre: a diferencia del recibo de venta (angosto, estilo ticket),
             este es un reporte formal de arqueo: ancho, con tablas y espacio para firmas. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Row="0">
            <Border x:Name="ReporteVisualBorder"
                    Background="White"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="28"
                    Margin="0,0,0,12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="3" Opacity="0.1" />
                </Border.Effect>

                <StackPanel>
                    <!-- Encabezado institucional -->
                    <TextBlock Text="PATRONATO NACIONAL DE CIEGOS, INC."
                               FontWeight="Bold" FontSize="18"
                               HorizontalAlignment="Center" Foreground="#0F172A" />
                    <TextBlock Text="RNC: 4-01-00623-1 · Calle Huáscar Tejeda #54, Zona Universitaria, Santo Domingo, D.N."
                               FontSize="11" HorizontalAlignment="Center" Foreground="#64748B" Margin="0,2,0,0" />

                    <!-- Barra de título del reporte, distinta del comprobante de venta -->
                    <Border Background="#0F172A" CornerRadius="4" Padding="14,10" Margin="0,16,0,16">
                        <StackPanel>
                            <TextBlock Text="REPORTE DE CIERRE Y ARQUEO DE CAJA"
                                       FontWeight="Bold" FontSize="16" Foreground="White" HorizontalAlignment="Center" />
                            <TextBlock Text="Corte consolidado de las operaciones del turno"
                                       FontSize="11" Foreground="#CBD5E1" HorizontalAlignment="Center" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Datos del cierre, en formato de ficha de reporte (no de lista de ticket) -->
                    <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="No. DE CIERRE" FontSize="10" Foreground="#64748B" FontWeight="SemiBold" />
                                <TextBlock x:Name="TxtNumeroCierre" Text="CIERRE-20260101-0000" FontSize="13" FontWeight="Bold" Foreground="#0284C7" Margin="0,0,0,10" />
                                <TextBlock Text="FECHA DEL CORTE" FontSize="10" Foreground="#64748B" FontWeight="SemiBold" />
                                <TextBlock x:Name="TxtFecha" Text="01/01/2026" FontSize="13" Foreground="#1E293B" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="SUCURSAL" FontSize="10" Foreground="#64748B" FontWeight="SemiBold" />
                                <TextBlock x:Name="TxtSucursal" Text="Sede Central Santo Domingo" FontSize="13" Foreground="#1E293B" Margin="0,0,0,10" />
                                <TextBlock Text="CAJERO RESPONSABLE" FontSize="10" Foreground="#64748B" FontWeight="SemiBold" />
                                <TextBlock x:Name="TxtCajero" Text="Ana Rosario" FontSize="13" Foreground="#1E293B" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Resumen por método de pago y por concepto, como tablas lado a lado -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="12">
                            <StackPanel>
                                <TextBlock Text="TOTALES POR MÉTODO DE PAGO" FontWeight="Bold" FontSize="11" Foreground="#1E293B" Margin="0,0,0,8" />
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Efectivo" FontSize="12" Foreground="#334155" />
                                    <TextBlock x:Name="TxtTotalEfectivo" Grid.Column="1" Text="RD$ 0.00" FontSize="12" FontWeight="Bold" Foreground="#047857" />
                                </Grid>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Tarjeta" FontSize="12" Foreground="#334155" />
                                    <TextBlock x:Name="TxtTotalTarjeta" Grid.Column="1" Text="RD$ 0.00" FontSize="12" FontWeight="Bold" Foreground="#0284C7" />
                                </Grid>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Transferencia" FontSize="12" Foreground="#334155" />
                                    <TextBlock x:Name="TxtTotalTransferencia" Grid.Column="1" Text="RD$ 0.00" FontSize="12" FontWeight="Bold" Foreground="#7C3AED" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="12">
                            <StackPanel>
                                <TextBlock Text="TOTALES POR CONCEPTO" FontWeight="Bold" FontSize="11" Foreground="#1E293B" Margin="0,0,0,8" />
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Ventas de Productos" FontSize="12" Foreground="#334155" />
                                    <TextBlock x:Name="TxtTotalVentas" Grid.Column="1" Text="RD$ 0.00" FontSize="12" FontWeight="Bold" Foreground="#1E293B" />
                                </Grid>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Masajes TACTO" FontSize="12" Foreground="#334155" />
                                    <TextBlock x:Name="TxtTotalMasajes" Grid.Column="1" Text="RD$ 0.00" FontSize="12" FontWeight="Bold" Foreground="#1E293B" />
                                </Grid>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Abonos a Préstamos" FontSize="12" Foreground="#334155" />
                                    <TextBlock x:Name="TxtTotalPrestamos" Grid.Column="1" Text="RD$ 0.00" FontSize="12" FontWeight="Bold" Foreground="#1E293B" />
                                </Grid>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Donaciones" FontSize="12" Foreground="#334155" />
                                    <TextBlock x:Name="TxtTotalDonaciones" Grid.Column="1" Text="RD$ 0.00" FontSize="12" FontWeight="Bold" Foreground="#1E293B" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Total general del cierre, como banner destacado (no como línea de ticket) -->
                    <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="4" Padding="14,12" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="TOTAL GENERAL DEL CIERRE" FontWeight="Bold" FontSize="12" Foreground="#065F46" />
                                <TextBlock x:Name="TxtCantidadTx" Text="0 transacciones auditadas en este corte" FontSize="11" Foreground="#047857" />
                            </StackPanel>
                            <TextBlock x:Name="TxtTotalGeneral" Grid.Column="1" Text="RD$ 0.00" FontWeight="Bold" FontSize="24" Foreground="#065F46" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Detalle de movimientos del turno -->
                    <TextBlock Text="DETALLE DE MOVIMIENTOS DEL TURNO" FontWeight="Bold" FontSize="12" Foreground="#1E293B" Margin="0,0,0,8" />
                    <DataGrid x:Name="GridMovimientos"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowBackground="White"
                              AlternatingRowBackground="#F8FAFC"
                              BorderBrush="#E2E8F0"
                              BorderThickness="1"
                              MaxHeight="260"
                              FontSize="11"
                              Margin="0,0,0,20">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Hora" Binding="{Binding FechaHora, StringFormat=hh:mm tt}" Width="70" />
                            <DataGridTextColumn Header="No. Recibo" Binding="{Binding NumeroRecibo}" Width="150" />
                            <DataGridTextColumn Header="Tipo" Binding="{Binding TipoTransaccion}" Width="130" />
                            <DataGridTextColumn Header="Método" Binding="{Binding MetodoPago}" Width="90" />
                            <DataGridTextColumn Header="Monto (RD$)" Binding="{Binding MontoTotal, StringFormat=N2}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Firmas: propio de un reporte de cierre formal, no aplica a un recibo de venta -->
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <Rectangle Height="1" Fill="#94A3B8" Margin="0,30,0,4" />
                            <TextBlock Text="Firma del Cajero" FontSize="11" HorizontalAlignment="Center" Foreground="#475569" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Rectangle Height="1" Fill="#94A3B8" Margin="0,30,0,4" />
                            <TextBlock Text="Firma de Supervisor / Administración" FontSize="11" HorizontalAlignment="Center" Foreground="#475569" />
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="TxtGeneradoEn" Text="Generado el 01/01/2026 12:00 PM" FontSize="9" HorizontalAlignment="Center" Foreground="#94A3B8" Margin="0,18,0,0" />
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- Botones de acción -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Imprimir Cierre de Caja"
                    Width="190" Height="36"
                    Background="#0F172A" Foreground="White"
                    FontWeight="SemiBold" FontSize="12"
                    BorderThickness="0" Margin="0,0,10,0"
                    Click="BtnImprimir_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="4" />
                    </Style>
                </Button.Resources>
            </Button>
            <Button Content="Cerrar"
                    Width="90" Height="36"
                    Background="#E2E8F0" Foreground="#334155"
                    FontWeight="SemiBold" FontSize="12"
                    BorderThickness="0"
                    Click="BtnCerrar_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="4" />
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
