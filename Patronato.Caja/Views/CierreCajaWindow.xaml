<Window x:Class="Patronato.Caja.Views.CierreCajaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cierre y Arqueo de Turno - Patronato Nacional de Ciegos"
        Height="800" Width="920"
        MinHeight="650" MinWidth="850"
        WindowStartupLocation="CenterOwner"
        Background="#F1F5F9">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0F172A" CornerRadius="8" Padding="18,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="CIERRE Y ARQUEO DE TURNO DE CAJA" FontWeight="Bold" FontSize="16" Foreground="White" />
                    <TextBlock Text="Auditoría física de efectivo, arqueo por conceptos y cierre del turno contable" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0" />
                </StackPanel>
                <Border Grid.Column="1" Background="#1E293B" CornerRadius="6" Padding="12,6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Turno: " Foreground="#94A3B8" FontSize="11" />
                        <TextBlock x:Name="TxtBadgeTurno" Text="#1 (Abierto)" Foreground="#38BDF8" FontWeight="Bold" FontSize="11" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Contenido con Pestañas: 1. Conteo Físico | 2. Reporte Formal -->
        <TabControl x:Name="TabCierre" Grid.Row="1" Background="Transparent" BorderThickness="0">
            <!-- TAB 1: CONTEO FÍSICO POR DENOMINACIÓN -->
            <TabItem Header="💵 Conteo de Efectivo por Denominación (RD$)">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="8,12,8,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <!-- Columna Izquierda: Tabla de Denominaciones -->
                        <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,10,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <TextBlock Text="DESGLOSE FÍSICO DE BILLETES Y MONEDAS" FontWeight="Bold" FontSize="12" Foreground="#1E293B" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button x:Name="BtnAutoCompletarConteo"
                                                Content="⚡ Cuadre Exacto"
                                                ToolTip="Auto-completar conteo físico con el monto esperado"
                                                Background="#0284C7" Foreground="White"
                                                FontWeight="Bold" FontSize="11"
                                                Padding="8,4" Margin="0,0,6,0"
                                                BorderThickness="0"
                                                Click="BtnAutoCompletarConteo_Click">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="4" />
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                        <Button x:Name="BtnLimpiarConteo"
                                                Content="🧹 Limpiar"
                                                ToolTip="Poner todas las cantidades en 0"
                                                Background="#F1F5F9" Foreground="#475569"
                                                FontWeight="SemiBold" FontSize="11"
                                                Padding="8,4"
                                                BorderThickness="1" BorderBrush="#CBD5E1"
                                                Click="BtnLimpiarConteo_Click">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="4" />
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                            <DataGrid x:Name="GridDenominaciones" Grid.Row="1" 
                                      AutoGenerateColumns="False" 
                                      CanUserAddRows="False" 
                                      CanUserDeleteRows="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      BorderBrush="#E2E8F0"
                                      BorderThickness="1"
                                      RowBackground="White"
                                      AlternatingRowBackground="#F8FAFC"
                                      CellEditEnding="GridDenominaciones_CellEditEnding"
                                      FontSize="12">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Tipo" Binding="{Binding Descripcion}" IsReadOnly="True" Width="140" />
                                    <DataGridTextColumn Header="Valor (RD$)" Binding="{Binding Valor, StringFormat=N2}" IsReadOnly="True" Width="100" />
                                    <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad, UpdateSourceTrigger=PropertyChanged}" Width="100" />
                                    <DataGridTextColumn Header="Subtotal (RD$)" Binding="{Binding Total, StringFormat=N2}" IsReadOnly="True" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock Grid.Row="2" Text="* Ingrese la cantidad contada físicamente de cada billete y moneda en la gaveta." FontSize="10" Foreground="#64748B" Margin="0,8,0,0" />
                        </Grid>
                    </Border>

                    <!-- Columna Derecha: Comparativa y Diferencia -->
                    <StackPanel Grid.Column="1">
                        <!-- Panel Resumen de Efectivo -->
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="BALANCE DE EFECTIVO DEL TURNO" FontWeight="Bold" FontSize="12" Foreground="#1E293B" Margin="0,0,0,12" />

                                <Grid Margin="0,4">
                                    <TextBlock Text="Fondo Inicial:" FontSize="12" Foreground="#475569" />
                                    <TextBlock x:Name="TxtFondoInicialResumen" Text="RD$ 0.00" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="#0F172A" />
                                </Grid>

                                <Grid Margin="0,4">
                                    <TextBlock Text="(+) Ventas en Efectivo:" FontSize="12" Foreground="#475569" />
                                    <TextBlock x:Name="TxtVentasEfectivoResumen" Text="RD$ 0.00" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="#047857" />
                                </Grid>

                                <Grid Margin="0,4">
                                    <TextBlock Text="(-) Total Anulado:" FontSize="12" Foreground="#475569" />
                                    <TextBlock x:Name="TxtAnulacionesResumen" Text="RD$ 0.00" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="#DC2626" />
                                </Grid>

                                <Separator Margin="0,8" Background="#E2E8F0" />

                                <Grid Margin="0,4">
                                    <TextBlock Text="Efectivo Esperado:" FontSize="13" FontWeight="Bold" Foreground="#1E3A8A" />
                                    <TextBlock x:Name="TxtEfectivoEsperado" Text="RD$ 0.00" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right" Foreground="#1E3A8A" />
                                </Grid>

                                <Grid Margin="0,4">
                                    <TextBlock Text="Efectivo Contado:" FontSize="13" FontWeight="Bold" Foreground="#0284C7" />
                                    <TextBlock x:Name="TxtEfectivoContadoTotal" Text="RD$ 0.00" FontSize="15" FontWeight="Bold" HorizontalAlignment="Right" Foreground="#0284C7" />
                                </Grid>

                                <!-- Banner de Diferencia (Sobrante / Faltante / Exacto) -->
                                <Border x:Name="BannerDiferencia" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,12,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock x:Name="TxtDiferenciaTitulo" Text="CUADRE EXACTO" FontWeight="Bold" FontSize="11" Foreground="#065F46" />
                                            <TextBlock x:Name="TxtDiferenciaSubtitulo" Text="Sin discrepancias en el arqueo" FontSize="10" Foreground="#047857" />
                                        </StackPanel>
                                        <TextBlock x:Name="TxtDiferenciaValor" Grid.Column="1" Text="RD$ 0.00" FontWeight="Bold" FontSize="16" Foreground="#065F46" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- DESTINO DEL EFECTIVO AL CIERRE (RETIRO / REMANENTE) -->
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="💼 " FontSize="13" />
                                    <TextBlock Text="DESTINO DEL EFECTIVO AL CIERRE" FontWeight="Bold" FontSize="11" Foreground="#0F172A" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="Seleccione el destino del dinero físico contado en la gaveta:" FontSize="10" Foreground="#64748B" Margin="0,0,0,8" TextWrapping="Wrap" />

                                <RadioButton x:Name="RbRetiroTotal" GroupName="DestinoEfectivo" IsChecked="True" Margin="0,0,0,6" Checked="RbDestino_Checked">
                                    <StackPanel Margin="4,0,0,0">
                                        <TextBlock Text="🏦 Retiro total a Bóveda / Remesa (Gaveta queda en RD$ 0.00)" FontWeight="SemiBold" FontSize="11" Foreground="#0F172A" />
                                        <TextBlock Text="Se entrega todo el dinero a la administración. La caja queda sin fondos." FontSize="9.5" Foreground="#64748B" />
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton x:Name="RbDejarFondo" GroupName="DestinoEfectivo" Margin="0,0,0,6" Checked="RbDestino_Checked">
                                    <StackPanel Margin="4,0,0,0">
                                        <TextBlock x:Name="TxtOpcionDejarFondoTitulo" Text="🔄 Dejar fondo base en gaveta y retirar recaudación" FontWeight="SemiBold" FontSize="11" Foreground="#0F172A" />
                                        <TextBlock Text="El fondo inicial queda para el siguiente turno. Solo se retiran las ventas netas." FontSize="9.5" Foreground="#64748B" />
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton x:Name="RbPersonalizado" GroupName="DestinoEfectivo" Margin="0,0,0,6" Checked="RbDestino_Checked">
                                    <StackPanel Margin="4,0,0,0">
                                        <TextBlock Text="✏️ Distribución manual personalizada" FontWeight="SemiBold" FontSize="11" Foreground="#0F172A" />
                                        <TextBlock Text="Especificar manualmente cuánto se entrega a bóveda y cuánto queda en caja." FontSize="9.5" Foreground="#64748B" />
                                    </StackPanel>
                                </RadioButton>

                                <Grid x:Name="PanelDistribucionManual" Margin="0,6,0,0" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Entrega a Bóveda (RD$):" FontSize="10" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,2" />
                                        <TextBox x:Name="TxtMontoBovedaManual" FontSize="11" FontWeight="Bold" Foreground="#047857" Padding="6,3" TextChanged="TxtMontoBovedaManual_TextChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Queda en Gaveta (RD$):" FontSize="10" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,2" />
                                        <TextBox x:Name="TxtMontoRemanenteManual" FontSize="11" FontWeight="Bold" Foreground="#1E3A8A" Padding="6,3" TextChanged="TxtMontoRemanenteManual_TextChanged" />
                                    </StackPanel>
                                </Grid>

                                <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,8,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="A BÓVEDA (RETIRO):" FontSize="9.5" FontWeight="Bold" Foreground="#15803D" />
                                            <TextBlock x:Name="TxtResumenEntregaBoveda" Text="RD$ 0.00" FontSize="13" FontWeight="Bold" Foreground="#047857" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="QUEDA EN GAVETA:" FontSize="9.5" FontWeight="Bold" Foreground="#1E40AF" />
                                            <TextBlock x:Name="TxtResumenQuedaGaveta" Text="RD$ 0.00" FontSize="13" FontWeight="Bold" Foreground="#1E3A8A" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Observaciones del Cierre -->
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Observaciones de Cierre (opcional):" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6" />
                                <TextBox x:Name="TxtObservacionesCierre" Height="60" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontSize="11" Padding="8,6" BorderBrush="#CBD5E1" Margin="0,0,0,12" />

                                <Button x:Name="BtnCerrarTurnoFinal" 
                                        Content="🔒 Confirmar y Cerrar Turno Contable" 
                                        Height="38" 
                                        Background="#0F172A" Foreground="White" 
                                        FontWeight="Bold" FontSize="12" 
                                        BorderThickness="0" 
                                        Click="BtnCerrarTurnoFinal_Click">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6" />
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: REPORTE FORMAL DE CIERRE Y ARQUEO -->
            <TabItem Header="📄 Reporte Formal de Arqueo">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                    <Border x:Name="ReporteVisualBorder"
                            Background="White"
                            BorderBrush="#CBD5E1"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="28"
                            Margin="0,0,0,12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="3" Opacity="0.1" />
                        </Border.Effect>

                        <StackPanel>
                            <!-- Encabezado institucional -->
                            <TextBlock Text="PATRONATO NACIONAL DE CIEGOS, INC." FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" Foreground="#0F172A" />
                            <TextBlock Text="RNC: 4-01-00623-1 · Calle Huáscar Tejeda #54, Zona Universitaria, Santo Domingo, D.N." FontSize="11" HorizontalAlignment="Center" Foreground="#64748B" Margin="0,2,0,0" />

                            <!-- Barra de título -->
                            <Border Background="#0F172A" CornerRadius="4" Padding="14,10" Margin="0,16,0,16">
                                <StackPanel>
                                    <TextBlock Text="REPORTE DE CIERRE Y ARQUEO DE CAJA" FontWeight="Bold" FontSize="16" Foreground="White" HorizontalAlignment="Center" />
                                    <TextBlock Text="Corte consolidado de las operaciones del turno" FontSize="11" Foreground="#CBD5E1" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Ficha del Cierre -->
                            <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="No. DE CIERRE / TURNO" FontSize="10" Foreground="#64748B" FontWeight="SemiBold" />
                                        <TextBlock x:Name="TxtNumeroCierre" Text="CIERRE-20261015-0001" FontSize="13" FontWeight="Bold" Foreground="#0284C7" Margin="0,0,0,10" />
                                        <TextBlock Text="FECHA DEL CORTE" FontSize="10" Foreground="#64748B" FontWeight="SemiBold" />
                                        <TextBlock x:Name="TxtFecha" Text="15/10/2026" FontSize="13" Foreground="#1E293B" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="SUCURSAL" FontSize="10" Foreground="#64748B" FontWeight="SemiBold" />
                                        <TextBlock x:Name="TxtSucursal" Text="Sede Central Santo Domingo" FontSize="13" Foreground="#1E293B" Margin="0,0,0,10" />
                                        <TextBlock Text="CAJERO RESPONSABLE" FontSize="10" Foreground="#64748B" FontWeight="SemiBold" />
                                        <TextBlock x:Name="TxtCajero" Text="Ana Rosario" FontSize="13" Foreground="#1E293B" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Resumen por Método y por Concepto -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="TOTALES POR MÉTODO DE PAGO" FontWeight="Bold" FontSize="11" Foreground="#1E293B" Margin="0,0,0,8" />
                                        <Grid Margin="0,3">
                                            <TextBlock Text="Efectivo" FontSize="12" Foreground="#334155" />
                                            <TextBlock x:Name="TxtTotalEfectivo" HorizontalAlignment="Right" Text="RD$ 0.00" FontSize="12" FontWeight="Bold" Foreground="#047857" />
                                        </Grid>
                                        <Grid Margin="0,3">
                                            <TextBlock Text="Tarjeta" FontSize="12" Foreground="#334155" />
                                            <TextBlock x:Name="TxtTotalTarjeta" HorizontalAlignment="Right" Text="RD$ 0.00" FontSize="12" FontWeight="Bold" Foreground="#0284C7" />
                                        </Grid>
                                        <Grid Margin="0,3">
                                            <TextBlock Text="Transferencia" FontSize="12" Foreground="#334155" />
                                            <TextBlock x:Name="TxtTotalTransferencia" HorizontalAlignment="Right" Text="RD$ 0.00" FontSize="12" FontWeight="Bold" Foreground="#7C3AED" />
                                        </Grid>
                                        <Separator Margin="0,6" Background="#E2E8F0" />
                                        <Grid Margin="0,3">
                                            <TextBlock Text="Fondo Inicial" FontSize="12" Foreground="#64748B" />
                                            <TextBlock x:Name="TxtReporteFondoInicial" HorizontalAlignment="Right" Text="RD$ 0.00" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" />
                                        </Grid>
                                        <Grid Margin="0,3">
                                            <TextBlock Text="Efectivo en Caja (Esperado)" FontSize="12" FontWeight="Bold" Foreground="#1E3A8A" />
                                            <TextBlock x:Name="TxtReporteEfectivoEsperado" HorizontalAlignment="Right" Text="RD$ 0.00" FontSize="12" FontWeight="Bold" Foreground="#1E3A8A" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="TOTALES POR CONCEPTO" FontWeight="Bold" FontSize="11" Foreground="#1E293B" Margin="0,0,0,8" />
                                        <Grid Margin="0,3">
                                            <TextBlock Text="Ventas de Productos" FontSize="12" Foreground="#334155" />
                                            <TextBlock x:Name="TxtTotalVentas" HorizontalAlignment="Right" Text="RD$ 0.00" FontSize="12" FontWeight="Bold" Foreground="#1E293B" />
                                        </Grid>
                                        <Grid Margin="0,3">
                                            <TextBlock Text="Masajes TACTO" FontSize="12" Foreground="#334155" />
                                            <TextBlock x:Name="TxtTotalMasajes" HorizontalAlignment="Right" Text="RD$ 0.00" FontSize="12" FontWeight="Bold" Foreground="#1E293B" />
                                        </Grid>
                                        <Grid Margin="0,3">
                                            <TextBlock Text="Abonos a Préstamos" FontSize="12" Foreground="#334155" />
                                            <TextBlock x:Name="TxtTotalPrestamos" HorizontalAlignment="Right" Text="RD$ 0.00" FontSize="12" FontWeight="Bold" Foreground="#1E293B" />
                                        </Grid>
                                        <Grid Margin="0,3">
                                            <TextBlock Text="Consultas Oftalmológicas" FontSize="12" Foreground="#334155" />
                                            <TextBlock x:Name="TxtTotalConsultas" HorizontalAlignment="Right" Text="RD$ 0.00" FontSize="12" FontWeight="Bold" Foreground="#1E293B" />
                                        </Grid>
                                        <Grid Margin="0,3">
                                            <TextBlock Text="Donaciones" FontSize="12" Foreground="#334155" />
                                            <TextBlock x:Name="TxtTotalDonaciones" HorizontalAlignment="Right" Text="RD$ 0.00" FontSize="12" FontWeight="Bold" Foreground="#1E293B" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Total General -->
                            <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="4" Padding="14,12" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="TOTAL GENERAL RECAUDADO" FontWeight="Bold" FontSize="12" Foreground="#065F46" />
                                        <TextBlock x:Name="TxtCantidadTx" Text="0 transacciones auditadas en este corte" FontSize="11" Foreground="#047857" />
                                    </StackPanel>
                                    <TextBlock x:Name="TxtTotalGeneral" Grid.Column="1" Text="RD$ 0.00" FontWeight="Bold" FontSize="22" Foreground="#065F46" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- SECCIÓN COMPROBANTE DE ENTREGA DE VALORES / REMESA -->
                            <Border BorderBrush="#0284C7" BorderThickness="1.5" CornerRadius="6" Padding="14" Margin="0,0,0,16" Background="#F0F9FF">
                                <StackPanel>
                                    <TextBlock Text="COMPROBANTE DE ENTREGA DE VALORES Y REMESA DE CAJA" FontWeight="Bold" FontSize="12" Foreground="#0369A1" HorizontalAlignment="Center" Margin="0,0,0,10" />
                                    <Grid Margin="0,3">
                                        <TextBlock Text="Total Efectivo Físico Contado:" FontSize="11.5" Foreground="#334155" />
                                        <TextBlock x:Name="TxtReciboEfectivoContado" HorizontalAlignment="Right" Text="RD$ 0.00" FontSize="11.5" FontWeight="Bold" Foreground="#0F172A" />
                                    </Grid>
                                    <Grid Margin="0,3">
                                        <TextBlock Text="(-) Fondo Remanente dejado en Gaveta (Base Próximo Turno):" FontSize="11.5" Foreground="#334155" />
                                        <TextBlock x:Name="TxtReciboFondoRemanente" HorizontalAlignment="Right" Text="RD$ 0.00" FontSize="11.5" FontWeight="Bold" Foreground="#1E3A8A" />
                                    </Grid>
                                    <Separator Margin="0,6" Background="#BAE6FD" />
                                    <Grid Margin="0,3">
                                        <TextBlock Text="(=) EFECTIVO TOTAL RETIRADO Y ENTREGADO A BÓVEDA / ADMINISTRACIÓN:" FontSize="12" FontWeight="Bold" Foreground="#0369A1" />
                                        <TextBlock x:Name="TxtReciboEntregadoBoveda" HorizontalAlignment="Right" Text="RD$ 0.00" FontSize="14" FontWeight="Bold" Foreground="#047857" />
                                    </Grid>
                                    <TextBlock x:Name="TxtReciboDestinoTexto" Text="Modalidad: Retiro total de valores hacia bóveda institucional." FontSize="10.5" Foreground="#0284C7" Margin="0,6,0,0" FontStyle="Italic" />
                                </StackPanel>
                            </Border>

                            <!-- Detalle de Movimientos -->
                            <TextBlock Text="DETALLE DE MOVIMIENTOS DEL TURNO" FontWeight="Bold" FontSize="12" Foreground="#1E293B" Margin="0,0,0,8" />
                            <DataGrid x:Name="GridMovimientos"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      RowBackground="White"
                                      AlternatingRowBackground="#F8FAFC"
                                      BorderBrush="#E2E8F0"
                                      BorderThickness="1"
                                      MaxHeight="220"
                                      FontSize="11"
                                      Margin="0,0,0,16">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Hora" Binding="{Binding FechaHora, StringFormat=hh:mm tt}" Width="70" />
                                    <DataGridTextColumn Header="No. Recibo" Binding="{Binding NumeroRecibo}" Width="140" />
                                    <DataGridTextColumn Header="Tipo" Binding="{Binding TipoTransaccion}" Width="120" />
                                    <DataGridTextColumn Header="Método" Binding="{Binding MetodoPago}" Width="90" />
                                    <DataGridTextColumn Header="Monto (RD$)" Binding="{Binding MontoTotal, StringFormat=N2}" Width="95" />
                                    <DataGridTextColumn Header="Estado" Binding="{Binding MotivoAnulacion, TargetNullValue='Normal'}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Firmas -->
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <Rectangle Height="1" Fill="#94A3B8" Margin="0,30,0,4" />
                                    <TextBlock Text="Firma del Cajero Responsable" FontSize="11" HorizontalAlignment="Center" Foreground="#475569" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <Rectangle Height="1" Fill="#94A3B8" Margin="0,30,0,4" />
                                    <TextBlock Text="Firma de Supervisor / Administración" FontSize="11" HorizontalAlignment="Center" Foreground="#475569" />
                                </StackPanel>
                            </Grid>

                            <TextBlock x:Name="TxtGeneradoEn" Text="Generado el 15/10/2026 12:00 PM" FontSize="9" HorizontalAlignment="Center" Foreground="#94A3B8" Margin="0,18,0,0" />
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Barra Inferior Permanente de Estado y Cierre -->
        <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="12,10,12,0" Margin="-16,10,-16,-6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Resumen en vivo del estado del arqueo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#EDE9FE" BorderBrush="#DDD6FE" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,10,0">
                        <TextBlock x:Name="TxtBottomEfectivoContado" Text="Contado: RD$ 0.00 / Esperado: RD$ 0.00" FontWeight="Bold" FontSize="11" Foreground="#5B21B6" VerticalAlignment="Center" />
                    </Border>
                    <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="4" Padding="8,4">
                        <TextBlock x:Name="TxtBottomEstadoCuadre" Text="⏳ Conteo pendiente" FontWeight="SemiBold" FontSize="11" Foreground="#92400E" VerticalAlignment="Center" />
                    </Border>
                </StackPanel>

                <!-- Acciones del Cierre -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnCerrarTurnoPrincipal"
                            Content="🔒 Confirmar y Cerrar Turno"
                            ToolTip="Cierra formalmente el turno contable y genera el comprobante de remesa"
                            Width="230" Height="38"
                            Background="#16A34A" Foreground="White"
                            FontWeight="Bold" FontSize="12.5"
                            BorderThickness="0" Margin="0,0,8,0"
                            Click="BtnCerrarTurnoFinal_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button Content="🖨️ Imprimir"
                            Width="105" Height="38"
                            Background="#0F172A" Foreground="White"
                            FontWeight="SemiBold" FontSize="11.5"
                            BorderThickness="0" Margin="0,0,8,0"
                            Click="BtnImprimir_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button Content="Cerrar"
                            Width="85" Height="38"
                            Background="#E2E8F0" Foreground="#334155"
                            FontWeight="SemiBold" FontSize="11.5"
                            BorderThickness="0"
                            IsCancel="True"
                            Click="BtnCerrar_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
