<Window x:Class="Patronato.Caja.Views.AperturaTurnoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Apertura de Turno de Caja - Patronato Nacional de Ciegos" 
        Height="460" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F1F5F9">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1E3A8A" CornerRadius="8" Padding="16,12" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="APERTURA DE TURNO DE CAJA" Foreground="White" FontWeight="Bold" FontSize="15" />
                <TextBlock Text="Ingrese el fondo inicial asignado para cambio y operaciones del turno" Foreground="#93C5FD" FontSize="11" Margin="0,2,0,0" />
            </StackPanel>
        </Border>

        <!-- Formulario -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="18">
            <StackPanel VerticalAlignment="Center">
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                        <TextBlock Text="Cajero(a) Responsable:" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                        <TextBox x:Name="TxtCajero" IsReadOnly="True" Background="#F8FAFC" FontSize="12" Padding="8,6" BorderBrush="#CBD5E1" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                        <TextBlock Text="Sucursal:" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                        <TextBox x:Name="TxtSucursal" IsReadOnly="True" Background="#F8FAFC" FontSize="12" Padding="8,6" BorderBrush="#CBD5E1" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Fondo Inicial en Efectivo (RD$):" FontSize="12" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,4" />
                <Border BorderBrush="#0284C7" BorderThickness="2" CornerRadius="6" Background="#F0F9FF" Padding="10,6" Margin="0,0,0,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="RD$ " FontSize="16" FontWeight="Bold" Foreground="#0284C7" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBox x:Name="TxtFondoInicial" Grid.Column="1" Text="3000.00" FontSize="18" FontWeight="Bold" Foreground="#0F172A" BorderThickness="0" Background="Transparent" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <TextBlock Text="Monto base con el que abre la gaveta para dar cambio al inicio del turno." FontSize="10" Foreground="#64748B" Margin="0,0,0,14" />

                <TextBlock Text="Observaciones de Apertura (opcional):" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                <TextBox x:Name="TxtObservaciones" Height="60" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontSize="11" Padding="8,6" BorderBrush="#CBD5E1" Background="White" />
            </StackPanel>
        </Border>

        <!-- Botones de Acción -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancelar" Width="100" Height="36" Background="#E2E8F0" Foreground="#475569" FontWeight="SemiBold" FontSize="12" BorderThickness="0" Margin="0,0,10,0" IsCancel="True" Click="BtnCancelar_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6" />
                    </Style>
                </Button.Resources>
            </Button>
            <Button x:Name="BtnConfirmar" Content="🔓 Abrir Turno" Width="150" Height="36" Background="#0284C7" Foreground="White" FontWeight="Bold" FontSize="12" BorderThickness="0" IsDefault="True" Click="BtnConfirmar_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6" />
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
