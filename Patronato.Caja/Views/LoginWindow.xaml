<Window x:Class="Patronato.Caja.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Acceso al Sistema de Caja - Patronato Nacional de Ciegos" 
        Height="540" Width="820"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="#0F172A">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*" />
            <ColumnDefinition Width="1.2*" />
        </Grid.ColumnDefinitions>

        <!-- PANEL IZQUIERDO: Branding Institucional -->
        <Border Grid.Column="0" Background="#1E3A8A" Padding="32">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <!-- Icono o Escudo Representativo -->
                    <Border Background="#2563EB" CornerRadius="12" Width="54" Height="54" HorizontalAlignment="Left" Margin="0,0,0,16">
                        <TextBlock Text="PNC" Foreground="White" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="PATRONATO NACIONAL" Foreground="#93C5FD" FontSize="13" FontWeight="Bold" />
                    <TextBlock Text="DE CIEGOS" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,2,0,4" />
                    <TextBlock Text="Módulo Operativo de Caja y Facturación POS" Foreground="#CBD5E1" FontSize="13" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,20">
                    <Border Background="#1E293B" CornerRadius="8" Padding="14" Margin="0,0,0,12" Opacity="0.8">
                        <StackPanel>
                            <TextBlock Text="• Venta de Insumos y Bastones" Foreground="White" FontWeight="SemiBold" FontSize="12" />
                            <TextBlock Text="Descuento automático de stock de suapers y bastones" Foreground="#94A3B8" FontSize="11" Margin="10,2,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Background="#1E293B" CornerRadius="8" Padding="14" Margin="0,0,0,12" Opacity="0.8">
                        <StackPanel>
                            <TextBlock Text="• Masajes TACTO y Préstamos" Foreground="White" FontWeight="SemiBold" FontSize="12" />
                            <TextBlock Text="Cobro a clientes y cuotas de microemprendimiento" Foreground="#94A3B8" FontSize="11" Margin="10,2,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Background="#1E293B" CornerRadius="8" Padding="14" Opacity="0.8">
                        <StackPanel>
                            <TextBlock Text="• Arqueo y Cierre Diario" Foreground="White" FontWeight="SemiBold" FontSize="12" />
                            <TextBlock Text="Emisión de comprobantes y cuadre del turno en tiempo real" Foreground="#94A3B8" FontSize="11" Margin="10,2,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <TextBlock Grid.Row="2" Text="República Dominicana • 2026" Foreground="#64748B" FontSize="11" />
            </Grid>
        </Border>

        <!-- PANEL DERECHO: Formulario de Autenticación -->
        <Border Grid.Column="1" Background="#FFFFFF" Padding="36,28">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Iniciar Sesión" FontSize="22" FontWeight="Bold" Foreground="#0F172A" />
                    <TextBlock Text="Acceso para Cajeros y Administradores" FontSize="13" Foreground="#64748B" Margin="0,4,0,18" />

                    <!-- Configuración de API Server -->
                    <TextBlock Text="Servidor API Core:" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtApiUrl" 
                                 Text="http://localhost:57141" 
                                 Height="32" 
                                 Padding="6,4" 
                                 FontSize="12"
                                 BorderBrush="#CBD5E1" />
                        <Button x:Name="BtnProbarConexion" 
                                Grid.Column="1" 
                                Content="Probar" 
                                Width="70" Height="32" 
                                Margin="6,0,0,0" 
                                Background="#F1F5F9" 
                                Foreground="#334155" 
                                BorderBrush="#CBD5E1" 
                                FontSize="11" 
                                Click="BtnProbarConexion_Click" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,-8,0,14">
                        <Ellipse x:Name="LedConexion" Width="8" Height="8" Fill="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock x:Name="TxtEstadoConexion" Text="Comprobando servidor..." FontSize="11" Foreground="#64748B" />
                    </StackPanel>

                    <!-- Nombre de Usuario -->
                    <TextBlock Text="Nombre de Usuario:" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" />
                    <TextBox x:Name="TxtUsuario" 
                             Text="cajero" 
                             Height="36" 
                             Padding="8,6" 
                             FontSize="13" 
                             BorderBrush="#CBD5E1" 
                             Margin="0,0,0,14" />

                    <!-- Contraseña -->
                    <TextBlock Text="Contraseña:" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" />
                    <PasswordBox x:Name="TxtPassword" 
                                 Password="cajero123" 
                                 Height="36" 
                                 Padding="8,6" 
                                 FontSize="13" 
                                 BorderBrush="#CBD5E1" 
                                 Margin="0,0,0,12" />

                    <!-- Mensaje de Error -->
                    <TextBlock x:Name="TxtError" 
                               Text="" 
                               Foreground="#DC2626" 
                               FontSize="12" 
                               TextWrapping="Wrap" 
                               Visibility="Collapsed" 
                               Margin="0,0,0,12" />

                    <!-- Botón de Entrar -->
                    <Button x:Name="BtnLogin" 
                            Content="Entrar a Caja" 
                            Height="42" 
                            Background="#0284C7" 
                            Foreground="White" 
                            FontWeight="Bold" 
                            FontSize="14" 
                            BorderThickness="0" 
                            Click="BtnLogin_Click" 
                            Margin="0,4,0,14">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                        </Button.Resources>
                    </Button>

                    <!-- Accesos Rápidos de Demostración -->
                    <TextBlock Text="ACCESO RÁPIDO PARA PRUEBAS:" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Margin="0,6,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Content="Cajero" 
                                Grid.Column="0" Height="28" 
                                Background="#F8FAFC" Foreground="#0284C7" 
                                BorderBrush="#BAE6FD" FontSize="11" 
                                Margin="0,0,3,0" 
                                Click="BtnDemoCajero_Click" 
                                ToolTip="Usuario: cajero / Clave: cajero123" />
                        <Button Content="Recepción" 
                                Grid.Column="1" Height="28" 
                                Background="#F8FAFC" Foreground="#7C3AED" 
                                BorderBrush="#DDD6FE" FontSize="11" 
                                Margin="3,0,3,0" 
                                Click="BtnDemoRecepcion_Click" 
                                ToolTip="Usuario: recepcion / Clave: recepcion123" />
                        <Button Content="Admin" 
                                Grid.Column="2" Height="28" 
                                Background="#F8FAFC" Foreground="#475569" 
                                BorderBrush="#CBD5E1" FontSize="11" 
                                Margin="3,0,0,0" 
                                Click="BtnDemoAdmin_Click" 
                                ToolTip="Usuario: admin / Clave: admin123" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
